# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files that must be normalized and converted
# to native line endings on checkout.
*.java text diff=java
*.xml text
*.txt text
*.json text
*.properties text
*.md text
*.html text diff=html
*.js text
*.css text
*.yml text
*.yaml text
*.svg text
*.jmx text
*.factories text
Jenkinsfile text
Dockerfile text

# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.gif binary
*.jpg binary
*.ico binary

# Misc.
extensions.json linguist-language=JavaScript
